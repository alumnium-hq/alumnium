{
  "extends": "./tsconfig",
  "include": ["./*/src/**/*.ts", "./core/package.json"],
  "exclude": [
    "./*/src/**/*.test.ts",
    "./*/src/**/*.eval.ts",
    "./*/src/**/__factories__/**"
  ],
  "compilerOptions": {
    // Output
    "outDir": "./tmp/npm-types",
    "emitDeclarationOnly": true,
    "declaration": true,
    // Build
    "incremental": false, // Always rebuild from scratch as we `rm -rf dist`
    // Project references
    "composite": false
  }
}

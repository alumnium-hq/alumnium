            <heading id=300 level=2>
              <div id=301>Signs of Ovulation</div>
              <div id=302></div>
            </heading>
            <list id=305>
              <listitem id=306 level=1>
                <div id=307>•</div>
                <div id=309>Rise in basal body temperature, typically 1/2 to 1 degree, measured by a thermometer</div>
              </listitem>
              <listitem id=310 level=1>
                <div id=311>•</div>
                <div id=313>Higher levels of luteinizing hormone (LH), measured on a home ovulation kit</div>
              </listitem>
              <listitem id=314 level=1>
                <div id=315>•</div>
                <div id=317>Cervical mucus, or vaginal discharge, may appear clearer, thinner, and stretchy, like raw egg whites</div>
              </listitem>
              <listitem id=318 level=1>
                <div id=319>•</div>
                <div id=321>Breast tenderness</div>
              </listitem>
              <listitem id=322 level=1>
                <div id=323>•</div>
                <div id=325>Bloating</div>
              </listitem>
              <listitem id=326 level=1>
                <div id=327>•</div>
                <div id=329>Spotting</div>
              </listitem>
              <listitem id=330 level=1>
                <div id=331>•</div>
                <div id=333>Slight pain or cramping in your side</div>
              </listitem>
            </list>
          </div>

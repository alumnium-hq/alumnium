---
import { tt } from "#/copy";
import Icon from "#/components/Icon.astro";

interface Props {
  content: string;
  label?: string;
}

const { content, label = "More details" } = Astro.props;
const noteId = `note-${crypto.randomUUID()}`;
---

<span class="value-with-note">
  <slot />
  <button
    type="button"
    class="note-trigger"
    data-note-trigger
    popovertarget={noteId}
    aria-label={label}
  >
    <Icon id="info" class="note-icon" />
  </button>
  <span
    id={noteId}
    popover="auto"
    class="note-bubble"
    role="tooltip"
    set:html={tt.md(content, true)}
  />
</span>

<style>
  @reference "#/styles/global.css";

  .value-with-note {
    @apply inline-flex items-center gap-1;
  }

  .note-trigger {
    @apply inline-flex items-center justify-center cursor-pointer bg-transparent border-0 p-0 appearance-none;
    --icon-color: var(--color-accent-400);
    line-height: 0;

    &:hover,
    &:focus-visible {
      --icon-color: var(--color-accent-100);
    }

    & .note-icon {
      font-size: 1.1em;
    }
  }

  .note-bubble {
    @apply bg-accent-900 text-accent-100 border border-accent-700 rounded-md shadow-lg text-sm font-normal font-sans normal-case leading-snug text-left px-3 py-2;
    position: fixed;
    margin: 0;
    inset: auto;
    max-width: min(18rem, calc(100vw - 1rem));

    & a {
      @apply text-accent-300 underline;
    }
  }
</style>

<script>
  const triggers = document.querySelectorAll<HTMLButtonElement>(
    "[data-note-trigger]",
  );

  triggers.forEach((trigger) => {
    const id = trigger.getAttribute("popovertarget");
    const bubble = id && document.getElementById(id);
    if (!bubble) return;

    bubble.addEventListener("toggle", (event) => {
      if ((event as ToggleEvent).newState !== "open") return;

      const t = trigger.getBoundingClientRect();
      const b = bubble.getBoundingClientRect();
      const margin = 8;

      let left = t.left + t.width / 2 - b.width / 2;
      left = Math.max(
        margin,
        Math.min(left, window.innerWidth - b.width - margin),
      );

      // Prefer above the trigger; flip below if there isn't room.
      let top = t.top - b.height - margin;
      if (top < margin) top = t.bottom + margin;

      bubble.style.left = `${left}px`;
      bubble.style.top = `${top}px`;
    });
  });
</script>

---
import TestClient from "#/components/blocks/TestClient.astro";
import VideoPlayer from "#/components/blocks/VideoPlayer.astro";
import { tt } from "#/copy";
import Step from "./Step.astro";

const t = tt.landings.sections.howSteps.test;
---

<Step t={t}>
  <Fragment slot="agents">
    <VideoPlayer
      src="/videos/landing-demo-hero.mov"
      label={t.agents.en.headline || "TODO"}
      aspectRatio="1920 / 1080"
      musicLicense="videos/landing-demo-hero-music-license.txt"
      muted
    />
  </Fragment>

  <Fragment slot="engineers">
    <TestClient />
  </Fragment>
</Step>

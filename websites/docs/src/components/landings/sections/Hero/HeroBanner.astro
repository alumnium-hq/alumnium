---
import { tt } from "#/copy";

const ttBanners = tt.landings.banners.sota;
const headline = ttBanners.headline.en;
---

<a
  class="relative rounded-full inline-flex items-center gap-2 px-2 sm:px-2.5 py-1 sm:py-1.5 no-underline font-mono text-xs uppercase border border-accent-600"
  href={ttBanners.href}
>
  <span class="badge text-lime-400">New</span>
  <span>{headline}</span>
</a>

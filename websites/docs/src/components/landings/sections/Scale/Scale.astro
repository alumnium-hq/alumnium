---
import { tt } from "#/copy";
import Section from "../../blocks/Section.astro";
import SharedCache from "./SharedCache.astro";
import Server from "./Server.astro";
import DeviceCloud from "./DeviceCloud.astro";
import Telemetry from "./Telemetry.astro";
import Ci from "./Ci.astro";
import Parallelism from "./Parallelism.astro";

const t = tt.landings.sections.scalable.en;
---

<div class="bento bento-cols-2">
  <Section
    heading={{ h: 2, align: true, style: "enlarge" }}
    t={t}
    span={2}
    style="header"
  />

  <Server />

  <SharedCache />

  <Ci />

  <Parallelism />

  <DeviceCloud />

  <Telemetry />
</div>

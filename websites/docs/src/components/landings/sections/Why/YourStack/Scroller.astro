---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

const agentLogos = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>(
    "../../../../../assets/logos/coding-agent-*-mono.svg",
  ),
);
fillInLogos("coding agent", agentLogos);

const aiLogos = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>(
    "../../../../../assets/logos/ai-*-mono.svg",
  ),
);
fillInLogos("AI", aiLogos);

const driverLogos = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>(
    "../../../../../assets/logos/driver-*-mono.svg",
  ),
);
fillInLogos("driver", driverLogos);

const langLogos = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>(
    "../../../../../assets/logos/lang-*-mono.svg",
  ),
);
fillInLogos("language", langLogos);

const alts: Record<string, string> = {
  openai: "OpenAI",
  anthropic: "Anthropic",
  gemini: "Google Gemini",
  grok: "xAI Grok",
  meta: "Meta Llama",
  deepseek: "DeepSeek",
  mistral: "Mistral",
  qwen: "Qwen",
  ollama: "Ollama",
  selenium: "Selenium",
  playwright: "Playwright",
  appium: "Appium",
  webdriverio: "WebdriverIO",
  python: "Python",
  javascript: "JavaScript",
  typescript: "TypeScript",
};

function pathToAlt(path: string) {
  const match = path.match(/\/logos\/(driver|ai|lang)-([a-z0-9-]+)-mono\.svg$/);
  if (match) {
    const [, , name] = match;
    const altBase =
      alts[name] ||
      name.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
    return altBase;
  }
  return "Logo";
}

function trackStyle<Type>(logos: Type[]): Record<string, string> {
  const count = logos.length;
  return {
    "--scroller-count": `${count}`,
  };
}

function fillInLogos<Type>(kind: string, logos: Type[]) {
  if (logos.length === 0) {
    throw new Error(`No ${kind} logos found`);
  }
  logos.push(...logos);
}
---

<div class="group">
  <div class="marquee" data-direction="down">
    <div class="track" style={trackStyle(aiLogos)}>
      {
        agentLogos.map(([logoPath, logo]) => (
          <Image src={logo()} alt={pathToAlt(logoPath)} />
        ))
      }
    </div>
  </div>

  <div class="marquee" data-direction="up">
    <div class="track" style={trackStyle(aiLogos)}>
      {
        aiLogos.map(([logoPath, logo]) => (
          <Image src={logo()} alt={pathToAlt(logoPath)} />
        ))
      }
    </div>
  </div>

  <div class="marquee" data-direction="down">
    <div class="track" style={trackStyle(driverLogos)}>
      {
        driverLogos.map(([logoPath, logo]) => (
          <Image src={logo()} alt={pathToAlt(logoPath)} />
        ))
      }
    </div>
  </div>

  <div class="marquee" data-direction="up">
    <div class="track" style={trackStyle(langLogos)}>
      {
        langLogos.map(([logoPath, logo]) => (
          <Image src={logo()} alt={pathToAlt(logoPath)} />
        ))
      }
    </div>
  </div>
</div>

<style>
  @reference "#/styles/global.css";

  .group {
    @apply flex items-stretch gap-2 md:gap-3;

    --scroller-height: calc(
      (var(--scroller-logo-size) + var(--scroller-gap-y)) *
        var(--scroller-visible-count)
    );

    --scroller-visible-count: 3;
    --scroller-logo-size: 40px;
    --scroller-gap-y: calc(var(--scroller-logo-size) / 1.6);

    @variant md {
      --scroller-visible-count: 5;
      --scroller-gap-y: 28px;
      --scroller-logo-size: 50px;
    }

    @variant lg {
      --scroller-visible-count: 5;
      --scroller-gap-y: 32px;
      --scroller-logo-size: 60px;
    }
  }

  .marquee {
    flex: 0 0 calc(var(--scroller-logo-size) * 1.5);
    height: var(--scroller-height);
    overflow: hidden;
    position: relative;
    mask-image: linear-gradient(
      to bottom,
      transparent 0,
      black 12%,
      black 88%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0,
      black 12%,
      black 88%,
      transparent 100%
    );
  }

  .track {
    --scroller-distance: calc(
      var(--scroller-count) *
        (var(--scroller-logo-size) + var(--scroller-gap-y)) / -2
    );

    display: flex;
    flex-direction: column;
    align-items: center;
    animation-name: logo-scroll-up;
    animation-duration: calc(var(--scroller-count) * 3s);
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    will-change: transform;
  }

  .marquee[data-direction="down"] .track {
    animation-name: logo-scroll-down;
  }

  .track img {
    height: var(--scroller-logo-size);
    width: auto;
    max-width: 100%;
    object-fit: contain;
    flex-shrink: 0;
    margin-bottom: var(--scroller-gap-y);
  }

  @property --scroller-distance {
    syntax: "<length>";
    inherits: false;
    initial-value: 0px;
  }

  @keyframes logo-scroll-up {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(0, var(--scroller-distance), 0);
    }
  }

  @keyframes logo-scroll-down {
    0% {
      transform: translate3d(0, var(--scroller-distance), 0);
    }
    100% {
      transform: translate3d(0, 0, 0);
    }
  }
</style>

---
import { tt } from "#/copy";
import Heading from "../../blocks/SectionHeading.astro";
import Section from "../../blocks/Section.astro";
import ComparisonTable from "./ComparisonTable.astro";

const t = tt.landings.sections.comparison.en;
---

<div class="bento">
  <Section style="compact">
    <Heading h={2} style="enlarge" align t={t} />

    <div class="table-wrapper">
      <ComparisonTable />
    </div>
  </Section>
</div>

<style>
  @reference "#/styles/global.css";

  .table-wrapper {
    @apply mx-[calc(var(--section-padding-x)*-1-0.5px)] sm:mx-0 flex flex-col gap-3 overflow-x-auto scrollbar-thin;
  }
</style>

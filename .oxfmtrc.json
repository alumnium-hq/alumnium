{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "**/pyproject.toml",
    // TODO: Enable it for Java too
    "packages/java/**/*",
    "websites/homepage/**/*",
    "**/__fixtures__/**/*"
  ],
  "printWidth": 80,
  "sortImports": {
    // Third-party packages go first, then `alumnium` and the other workspace
    // packages.
    "customGroups": [
      {
        "groupName": "alumnium",
        "elementNamePattern": ["alumnium", "alumnium/**"]
      }
    ],
    "groups": [
      "builtin",
      "external",
      "alumnium",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ],
    "internalPattern": ["@alumnium/"],
    "newlinesBetween": false
  }
}
